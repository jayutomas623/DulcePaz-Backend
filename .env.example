# ==============================================================================
# Dulce Paz API - Variables de Entorno (Archivo de Ejemplo)
# ==============================================================================

# Entorno y Servidor
PROJECT_NAME="Dulce Paz API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
TIMEZONE="America/La_Paz"

# CORS (Orígenes permitidos en desarrollo y producción)
# Puede ser una lista JSON o cadenas separadas por coma
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://dulcepaz.com"]

# Base de Datos (Supabase PostgreSQL)
# Obtén estas credenciales en: https://supabase.com -> Project Settings -> API
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Email Transaccional (Resend) - [COLABORADOR 1]
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Dulce Paz <contacto@dulcepaz.com>"
NOTIFICATION_EMAIL="contacto@dulcepaz.com"

# ------------------------------------------------------------------------------
# MÓDULOS DE INTEGRACIÓN ASIGNADOS AL COLABORADOR 2
# ------------------------------------------------------------------------------

# Google Workspace / Calendar & Google Meet - [COLABORADOR 2]
# JSON string o path al archivo de Service Account de Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_CALENDAR_ADMIN_EMAIL="contacto@dulcepaz.com"

# Meta WhatsApp Cloud API - [COLABORADOR 2]
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_FALLBACK_PHONE="+59176543210"

# Seguridad Admin / Tokens JWT
ADMIN_SECRET_KEY="supersecretadminjwtkey_change_in_production"
